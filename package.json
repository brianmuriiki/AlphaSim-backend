{
  "name": "alphasim-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/dev.js",
    "dev:api": "node --watch src/server.js",
    "dev:worker": "node --watch src/workers/simulation.worker.js",
    "dev:mock-brain": "node --watch src/mock-brain/server.js",
    "start": "node src/server.js",
    "start:worker": "node src/workers/simulation.worker.js",
    "test": "vitest run --exclude tests/tenant-isolation.test.js",
    "test:integration": "vitest run tests/tenant-isolation.test.js",
    "test:watch": "vitest",
    "lint": "find src tests -type f -name '*.js' -exec node --check {} \\;"
  },
  "dependencies": {
    "@bull-board/api": "^6.9.2",
    "@bull-board/express": "^6.9.2",
    "@sentry/node": "^11.8.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.10",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "rate-limit-redis": "^4.2.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.3",
    "supertest": "^7.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
